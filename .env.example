# ---------------------------------------------------------------------------
# Lernzeit - Beispielumgebung
#
# Nur oeffentliche Werte. Niemals Secret-, service_role-, Datenbank-, Expo- oder
# EAS-Schluessel in EXPO_PUBLIC_* ablegen: alles mit diesem Praefix landet im
# ausgelieferten App-Bundle und ist damit oeffentlich.
#
# Ohne diese Datei startet die App im Entwicklungsmodus mit klar markierten
# Testwerten (lernzeit.invalid). Production-Builds werden von
# scripts/check-release-config.mjs und app.config.js abgebrochen, solange eine
# Pflichtangabe fehlt oder noch ein Platzhalter ist.
#
# Vollstaendige Feldliste: config/operator-fields.json
# Anleitung:               docs/operator-configuration.md
# Aktueller Stand pruefen: npm run release:report
# ---------------------------------------------------------------------------

# --- Supabase (Pflicht fuer Online-Konten) ---------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nur als kompatibler Ersatz fuer den Publishable Key verwenden, nicht zusaetzlich.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Oeffentliche Betreiberdomain ------------------------------------------
# Muss dem Betreiber gehoeren und /account-deletion/ sowie
# /.well-known/assetlinks.json ausliefern. Bestimmt zugleich den verifizierten
# Android-App-Links-Host und den erlaubten HTTPS-Recovery-Callback.
EXPO_PUBLIC_LEGAL_SITE_URL=

# --- Impressum --------------------------------------------------------------
EXPO_PUBLIC_OPERATOR_NAME=
EXPO_PUBLIC_OPERATOR_LEGAL_FORM=
EXPO_PUBLIC_OPERATOR_ADDRESS=
EXPO_PUBLIC_OPERATOR_CONTACT_EMAIL=
# Optional. Leer lassen ist zulaessig.
EXPO_PUBLIC_OPERATOR_PHONE=
EXPO_PUBLIC_OPERATOR_REGISTER=
EXPO_PUBLIC_OPERATOR_SUPERVISORY_AUTHORITY=
EXPO_PUBLIC_OPERATOR_VAT_ID=
EXPO_PUBLIC_OPERATOR_DISPUTE_RESOLUTION=

# --- Datenschutz und Support ------------------------------------------------
EXPO_PUBLIC_PRIVACY_CONTACT_EMAIL=
EXPO_PUBLIC_PRIVACY_OFFICER=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_ABUSE_CONTACT_EMAIL=
EXPO_PUBLIC_DATA_PROTECTION_AUTHORITY=
EXPO_PUBLIC_LEGAL_BASIS_ACCOUNT=

# --- Auftragsverarbeitung ---------------------------------------------------
EXPO_PUBLIC_SUPABASE_CONTRACT_PARTY=
EXPO_PUBLIC_SUPABASE_REGION=
EXPO_PUBLIC_SUPABASE_DPA_REFERENCE=
EXPO_PUBLIC_PRODUCTION_SUBPROCESSORS=

# --- Aufbewahrung und Rechtstexte -------------------------------------------
EXPO_PUBLIC_LOG_RETENTION_POLICY=
EXPO_PUBLIC_STATUTORY_RETENTION=
EXPO_PUBLIC_TERMS_LIABILITY=
EXPO_PUBLIC_LEGAL_EFFECTIVE_DATE=

# --- Nur fuer lokale Android-Builds -----------------------------------------
# EAS verwaltet den versionCode bei appVersionSource "remote" selbst. Fuer einen
# lokalen AAB muss die Nummer hier gesetzt und streng monoton erhoeht werden.
# ANDROID_VERSION_CODE=1
# SHA-256-Fingerprint des Play-App-Signaturschluessels fuer assetlinks.json.
# ANDROID_SHA256_CERT_FINGERPRINTS=
