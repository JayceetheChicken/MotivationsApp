# Ausschließlich öffentliche Supabase-Projektwerte. Niemals Secret-,
# service_role-, Datenbank-, Expo- oder EAS-Schlüssel in EXPO_PUBLIC_* ablegen.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Nur als kompatibler Ersatz für den Publishable Key verwenden, nicht zusätzlich.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
