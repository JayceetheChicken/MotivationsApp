{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 no longer pulls every @types package in automatically. The
    // release tooling under scripts/ and the tests that exercise it are plain
    // Node programs, so the Node typings have to be requested explicitly.
    // "jest" arrives through the reference in __tests__/jest-globals.d.ts.
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "supabase/functions/*/index.ts"
  ]
}
