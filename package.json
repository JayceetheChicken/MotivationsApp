{
  "name": "lernzeit-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo-image",
        "expo-sharing"
      ]
    }
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@expo/ui": "~57.0.9",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "~57.0.11",
    "expo-build-properties": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "57.0.1",
    "expo-image-manipulator": "~57.0.8",
    "expo-image-picker": "~57.0.8",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "supabase": "2.109.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:lint": "supabase db lint --local --level warning",
    "test:db": "supabase test db",
    "test:supabase:e2e": "node scripts/supabase-local-e2e.mjs",
    "types:db": "supabase gen types typescript --local > src/types/database.generated.ts",
    "release:check": "node scripts/check-release-config.mjs",
    "release:gate": "node scripts/check-release-config.mjs --production",
    "release:report": "node scripts/check-release-config.mjs --report",
    "release:pages": "node scripts/build-public-pages.mjs",
    "assets:build": "node scripts/build-brand-assets.mjs",
    "licenses:check": "node scripts/build-third-party-notices.mjs --check",
    "licenses:build": "node scripts/build-third-party-notices.mjs",
    "check:sensitive": "node scripts/check-sensitive-files.mjs",
    "verify": "npm run check:sensitive && npm run release:check && npm run typecheck && npm test && npm run lint && npm run licenses:check && npx expo-doctor"
  },
  "private": true
}
